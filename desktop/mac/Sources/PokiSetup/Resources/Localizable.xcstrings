    "Apple verified the code, but did not finish opening the session. Sign in again to start a fresh session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verified the code, but did not finish opening the session. Sign in again to start a fresh session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已验证双重验证码但未完成建连，请重新登录一次。"
          }
        }
      }
    },
    "Apple's sign-in wants proof that it talks to a Mac or PC (“anisette”). A server provides it; it never sees your Apple Account or password. If sign-in fails, try another one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's sign-in wants proof that it talks to a Mac or PC (“anisette”). A server provides it; it never sees your Apple Account or password. If sign-in fails, try another one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 登录需要设备环境凭证（Anisette）。身份验证服务器仅生成环境参数，绝不会接触你的 Apple 账户或密码；若登录失败可切换其他节点。"
          }
        }
      }
    },
