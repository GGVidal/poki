    "Poki Setup could not read your saved Apple Account from the macOS keychain. Your session was not signed out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup could not read your saved Apple Account from the macOS keychain. Your session was not signed out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup 无法从 macOS 钥匙串读取已保存的 Apple 账户，你的会话并未退出。"
          }
        }
      }
    },
    "Poki Setup could not replace itself here, so its update is open in Finder. Quit Poki Setup, then drag the new one into Applications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup could not replace itself here, so its update is open in Finder. Quit Poki Setup, then drag the new one into Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup 无法在当前位置替换自身，已在访达中打开更新包。请退出后将新版本拖入“应用程序”。"
          }
        }
      }
    },
    "Poki Setup deploys the relay from the same release as the Poki on your iPhone, checked against that release's SHA256SUMS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup deploys the relay from the same release as the Poki on your iPhone, checked against that release's SHA256SUMS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup 会部署与手机端同版本的中继代码并校验 SHA256SUMS。"
          }
        }
      }
    },
    "Poki Setup downloads the update, checks its signature and restarts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup downloads the update, checks its signature and restarts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup 将下载更新包、校验签名并自动重启。"
          }
        }
      }
    },
    "Poki Setup renews Poki before it stops opening, every few hours while this Mac is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki Setup renews Poki before it stops opening, every few hours while this Mac is on."
