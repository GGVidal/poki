public struct Capability {
}

public protocol DeviceCapabilityProtocol {
}

public protocol DeviceCapability {
  associatedtype ProtocolType
  associatedtype ImplType
  static var capability: CoreDevice.Capability { get }
}

public struct CapabilityStaticMember<T> {
}

public struct HIDDeviceCapability : CoreDevice.DeviceCapability {
  public typealias ProtocolType = Swift.Never
  public typealias ImplType = Swift.Never
  public static var capability: CoreDevice.Capability { get }
}

public struct DigitizerHIDCapability : CoreDevice.DeviceCapability {
  public typealias ProtocolType = any CoreDevice.HIDDigitizer
  public typealias ImplType = Swift.Never
  public static var capability: CoreDevice.Capability { get }
}

extension CoreDevice.CapabilityStaticMember where T : CoreDevice.DeviceCapability {
  public static var hid: CoreDevice.CapabilityStaticMember<CoreDevice.HIDDeviceCapability>.Type { get }
}

extension CoreDevice.CapabilityStaticMember where T == CoreDevice.HIDDeviceCapability {
  public static var digitizer: CoreDevice.CapabilityStaticMember<CoreDevice.DigitizerHIDCapability> { get }
}

